# Paths
JARVIS_HOME=${HOME}/.local/share/jarvis-home
JARVIS_STATE_DIR=${JARVIS_HOME}/state
JARVIS_API_KEY_FILE=${JARVIS_HOME}/secrets/api-key

# Jarvis Bridge
JARVIS_HOST=127.0.0.1
JARVIS_PORT=18083
JARVIS_TWO_STAGE_ARBITRATION=1
JARVIS_SEMANTIC_ROUTER=1
JARVIS_ROUTER_MIN_CONFIDENCE=0.8

# Local models
JARVIS_ROUTER_URL=http://127.0.0.1:11435/api/generate
JARVIS_ROUTER_MODEL=qwen35-router:0.8b
JARVIS_LEVEL2_URL=http://127.0.0.1:11434/api/generate
JARVIS_LEVEL2_MODEL=qwen35-4b-16k:latest
JARVIS_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
JARVIS_LOCAL_MODEL=qwen35-4b-16k:latest

# Optional external home backend (disabled by default; installed separately)
JARVIS_EXTERNAL_HOME_ENABLED=0
JARVIS_EXTERNAL_HOME_BASE_URL=

# External agent runtime
OPENCLAW_WS=ws://127.0.0.1:18789/stream

# Never put real tokens in this example file.
